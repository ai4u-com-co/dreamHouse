# Los renders usan GPT Image 2.5 (OpenAI) por defecto. Cada usuario pega su clave de OpenAI en el encabezado de la app.
# OPENAI_API_KEY es opcional: solo sirve de respaldo en el servidor (con calidad limitada a "Estándar" y resolución a 2K).
# OPENAI_API_KEY=your_openai_api_key_here

# Google Gemini API Key (opcional: solo si se elige el modelo Gemini)
# Obtén tu clave en: https://makersuite.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Entorno de Vercel (opcional, configurado automáticamente por Vercel)
# NEXT_PUBLIC_VERCEL_ENV=production
